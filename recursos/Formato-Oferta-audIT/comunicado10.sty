% ============================================================================
%  comunicado10.sty
%  Adaptación del formato al Comunicado 10 (23-09-2026), que fija la
%  estructura obligatoria de cada subdocumento. Decisiones D4-49 y D4-50.
%
%  Orden de un subdocumento (Comunicado 10, secciones 1, 2.5 y 2.6):
%    portada y ficha (FEP01, Artículo 40), índice detallado con folios e
%    hipervínculos, filas de la tabla del Artículo 46 que le tocan, título del
%    capítulo con el texto del Comunicado 10 y su introducción, secciones del
%    índice obligatorio, y al final dos secciones sin número: Referencias y
%    Declaración de uso de IA.
%  Cada formulario sale en su propio archivo (sección 1, regla 1):
%    AUDIT-Formulario-T-11.pdf, con portada, ficha y el formulario.
%
%  Comandos nuevos
%    \TituloComunicado{4}{Introducción a la Arquitectura ...}  en la configuración
%    \requiereDupla{3}{qué falta}   dato que entrega otra dupla (D4-53)
%    \figuraHorizontal{archivo}{leyenda}{etiqueta}   figura en página apaisada
%                                    en la página siguiente a la cita
%    \comunicado{10}{sección 11}    cita al Comunicado 10 o 9
%    \usoIA{sección}{herramienta}{finalidad}{texto}{diagramas}{revisión}
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{comunicado10}[2026/09/29 Estructura del Comunicado 10]

\RequirePackage{afterpage}

% ----------------------------------------------------------------------------
%  Títulos literales del Comunicado 10, sección 11
% ----------------------------------------------------------------------------
\ExplSyntaxOn
\prop_new:N \g_audit_titulo_com_prop
\NewDocumentCommand \TituloComunicado { m m }
  { \prop_gput:Nnn \g_audit_titulo_com_prop {#1} {#2} }
\NewExpandableDocumentCommand \tituloComunicadoDe { m }
  { \prop_item:Nn \g_audit_titulo_com_prop {#1} }
\ExplSyntaxOff

% ----------------------------------------------------------------------------
%  Dato que entrega otra dupla. Se ve en el PDF y queda en el registro como
%  marcador: el Comunicado 10, sección 7.1 d), lo trata como residuo y tiene
%  que desaparecer antes de entregar.
% ----------------------------------------------------------------------------
\DeclareRobustCommand\requiereDupla[2]{%
  {\sffamily\bfseries\color{fig-red}[Información requerida por dupla #1: #2]}%
  \ifdefined\audit@marcadores@log
    \immediate\write-1{AUDIT-MARCADOR: dupla #1: \detokenize{#2}}%
  \fi}
\pdfstringdefDisableCommands{\def\requiereDupla#1#2{[Información requerida por dupla #1: #2]}}

% ----------------------------------------------------------------------------
%  Citas a las bases con su entrada en Referencias (D4-30). Las bases van con
%  autor Transportes Curimón S.A. en referencias/bases.bib y entran a la
%  lista solo si el subdocumento las cita.
% ----------------------------------------------------------------------------
\addbibresource{referencias/bases.bib}
\ExplSyntaxOn
\cs_new_protected:Npn \audit_nocite_base:n #1
  {
    \str_case:nn {#1}
      {
        { FEP01 } { \nocite{bases-fep01} }
        { FEP02 } { \nocite{bases-fep02} }
        { Caso }  { \nocite{bases-fep03} }
        { FEP03 } { \nocite{bases-fep03} }
      }
  }
\RenewDocumentCommand \bases { s m m m }
  { \audit_nocite_base:n {#2} \audit_bases:nnnn { #1 } {#2} {#3} {#4} }
\RenewDocumentCommand \art { s m m }
  { \nocite{bases-fep01} \audit_bases:nnnn { #1 } { FEP01 } { Artículo~#2 } {#3} }
\RenewDocumentCommand \form { s m m }
  { \nocite{bases-fep01} \audit_bases:nnnn { #1 } { FEP01 } { Formulario~#2 } {#3} }
\RenewDocumentCommand \transv { s m m }
  { \nocite{bases-fep02} \audit_bases:nnnn { #1 } { FEP02 } {#2} {#3} }
\RenewDocumentCommand \caso { s m m }
  { \nocite{bases-fep03} \audit_bases:nnnn { #1 } { Caso } {#2} {#3} }
% \comunicado{10}{sección 11}  ->  Comunicado 10, sección 11
\NewDocumentCommand \comunicado { s m m }
  {
    \nocite{bases-com#2}
    \bool_if:nT {#1} { ( }
    Comunicado~#2,~#3
    \bool_if:nT {#1} { ) }
  }
\ExplSyntaxOff
% Toda cita cuenta para imprimir las Referencias
\AtEveryCitekey{\ifaudit@citaescrita\else
  \immediate\write\@auxout{\string\setcounter{audit@citas}{1}}%
  \global\audit@citaescritatrue\fi}

\renewcommand\convencionCitas{%
  Las bases se citan por documento, artículo o numeral y página impresa:
  FEP01 son las Bases Administrativas, FEP02 las Bases Técnicas
  Transversales y Caso las Bases Técnicas del Caso 10. Las fuentes externas
  se citan en norma APA 7.ª edición. Todas se listan en la sección
  Referencias, al final del subdocumento.}

% ----------------------------------------------------------------------------
%  Índice detallado al comienzo del subdocumento
% ----------------------------------------------------------------------------
\titlecontents{lchapter}[12mm]
  {\addvspace{4pt}\sffamily\bfseries\fontsize{10.5bp}{13.5bp}\selectfont\color{audit-marino}}
  {\contentslabel{12mm}}{}
  {\audit@puntos\contentspage}

\newcommand\audit@iniciarpartes{%
  \startcontents[subdoc]%
  \startlist[subdoc]{lof}%
  \startlist[subdoc]{lot}}

\newcommand\indiceDetallado{%
  \clearpage
  \begin{paginaAncha}%
  {\let\addcontentsline\@gobblethree
   \tituloPagina[Índice]{Subdocumento N.º \subdocActual}{Índice}{indice-sd}}%
  \global\audit@indicelocaltrue
  \printcontents[subdoc]{l}{0}{\setcounter{tocdepth}{3}}%
  \ifnum\ifcsname audit@nfig@\subdocActual\endcsname
      \csname audit@nfig@\subdocActual\endcsname\else0\fi>0
    \par\vspace{9pt}\noindent\audit@rotulo{Figuras}\par\vspace{3pt}%
    {\color{audit-filete}\hrule height 0.4pt}\vspace{4pt}%
    \printlist[subdoc]{lof}{l}{}%
  \fi
  \ifnum\ifcsname audit@ntab@\subdocActual\endcsname
      \csname audit@ntab@\subdocActual\endcsname\else0\fi>0
    \par\vspace{9pt}\noindent\audit@rotulo{Tablas}\par\vspace{3pt}%
    {\color{audit-filete}\hrule height 0.4pt}\vspace{4pt}%
    \printlist[subdoc]{lot}{l}{}%
  \fi
  \end{paginaAncha}%
  \clearpage}

% ----------------------------------------------------------------------------
%  Apertura del capítulo con el título del Comunicado 10. No abre partes del
%  índice (ya se abrieron antes de imprimirlo) ni imprime resumen: debajo va
%  el texto de introducción (Comunicado 10, sección 2.6).
% ----------------------------------------------------------------------------
\newcommand\aperturaComunicado[1]{%
  \clearpage
  \thispagestyle{plain}%
  \audit@marcasubdoc{Subdocumento #1}%
  \setcounter{chapter}{\numexpr#1-1\relax}%
  \refstepcounter{chapter}%
  \global\audit@indicelocaltrue
  \phantomsection
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}\tituloComunicadoDe{#1}}%
  \markboth{\tituloSubdocActual}{}\markright{}%
  \registrarFolio{sd-#1}{Subdocumento #1. \tituloSubdocActual}%
  \noindent\hspace*{-\desplazamientoCarril}%
  \begin{minipage}[t]{\desplazamientoCarril}%
    \raggedleft\vspace{-3pt}%
    {\plexligera\fontsize{66bp}{60bp}\selectfont\color{audit-marino}\thechapter}%
    \hspace*{\separacionCarril}%
  \end{minipage}%
  \begin{minipage}[t]{\textwidth}%
    \vspace{0pt}\motivoApertura
    \audit@rotulo{Subdocumento N.º \thechapter. \tituloSubdocActual}\par\vspace{4pt}%
    {\sffamily\bfseries\fontsize{24bp}{28bp}\selectfont\color{audit-marino}%
      \raggedright\tituloComunicadoDe{#1}\par}%
    \vspace{6pt}%
    {\color{audit-turquesa}\rule{30mm}{1.2pt}}%
  \end{minipage}\par
  \vspace{11pt}\@afterheading}

% ----------------------------------------------------------------------------
%  Figura en página horizontal, en la página que sigue a la cita (Comunicado
%  10, sección 4.3: se admite página horizontal para figuras de gran formato).
%  Reutiliza la página apaisada del anexo gráfico, pero entra al índice como
%  figura y no como anexo, y no se acumula al final del subdocumento.
% ----------------------------------------------------------------------------
\newif\ifaudit@figh
\ExplSyntaxOn
\bool_new:N \g_audit_figh_bool
\NewDocumentCommand \figuraHorizontal { m m m }
  { \afterpage { \audit_figh_emitir:nnn {#1} {#2} {#3} } }
\cs_new_protected:Npn \audit_figh_emitir:nnn #1#2#3
  {
    \bool_gset_true:N \g_audit_figh_bool
    \global\audit@fightrue
    \audit_anexo_pagina:nnn {#1} {#2} {#3}
    \global\audit@fighfalse
    \bool_gset_false:N \g_audit_figh_bool
  }
\cs_set_eq:NN \audit_anexo_entrada_original:nn \audit_anexo_entrada:nn
\cs_set_protected:Npn \audit_anexo_entrada:nn #1#2
  {
    \bool_if:NTF \g_audit_figh_bool
      { \phantomsection }
      { \audit_anexo_entrada_original:nn {#1} {#2} }
  }
\ExplSyntaxOff
\let\audit@encabezadoanexo@original\audit@encabezadoanexo
\renewcommand\audit@encabezadoanexo[1]{%
  \ifaudit@figh
    \noindent{\color{audit-filete}\rule{\linewidth}{0.4pt}}\par
    \nointerlineskip\vspace{3pt}%
    \noindent{\sffamily\fontsize{9bp}{11bp}\selectfont\color{audit-secundario}%
      SUBDOCUMENTO \thechapter\enspace\textperiodcentered\enspace
      \MakeUppercase{\tituloSubdocActual}\enspace\textperiodcentered\enspace
      PÁGINA HORIZONTAL CONFORME A FEP01, ARTÍCULO 40.4 Y COMUNICADO 10, SECCIÓN 4.3\strut\par}%
  \else
    \audit@encabezadoanexo@original{#1}%
  \fi}

% ----------------------------------------------------------------------------
%  Cierre: Referencias y Declaración de uso de IA, sin número y en ese orden
%  (Comunicado 10, secciones 2.5, 6.3 y 7.2)
% ----------------------------------------------------------------------------
\newcommand\audit@titulocierre[1]{%
  \par\Needspace{8\baselineskip}\vspace{14pt plus 3pt}%
  \phantomsection
  \addcontentsline{toc}{section}{#1}%
  \markright{#1}%
  \noindent
  {\sffamily\bfseries\fontsize{17bp}{21bp}\selectfont\color{audit-marino}#1\par}%
  \vspace{5pt}\@afterheading}

\newcommand\cierreReferencias{%
  \clearpage
  \audit@titulocierre{Referencias}%
  \noindent Fuentes citadas en este subdocumento, en norma APA 7.ª edición. Las
  bases de la licitación figuran con su autor, el mandante, y se citan en el
  texto por documento, artículo o numeral y página. Cada entrada indica el
  folio donde se usa.\par\vspace{8pt}%
  \printbibliography[heading=none]}

% Filas de la declaración: \usoIA{sección}{herramienta}{finalidad}{texto}{diagramas}{revisión}
\ExplSyntaxOn
\tl_new:N \g_audit_usoia_tl
\NewDocumentCommand \usoIA { m m m m m m }
  { \tl_gput_right:Nn \g_audit_usoia_tl { #1 & #2 & #3 & #4 & #5 & #6 \\ } }
\NewDocumentCommand \filasUsoIA { } { \tl_use:N \g_audit_usoia_tl }
\ExplSyntaxOff

\newcommand\cierreDeclaracionIA[1]{%
  \BuscarArchivoSubdoc{\carpetaDeSubdocumento{#1}}{declaracion-ia.tex}%
  \audit@titulocierre{Declaración de uso de IA}%
  \noindent Conforme al Comunicado 10, sección 7.2, cada sección de este
  subdocumento y cada formulario asociado declara la herramienta de
  inteligencia artificial generativa usada, su finalidad, el nivel de uso en
  texto y en diagramas según la escala oficial de esa sección, y quién revisó
  y qué verificó. Esta declaración se consolida en el Formulario A-6.\par
  \InputIfFileExists{\rutaEncontrada}{}{\usoIA{\marcador{sección}}{}{}{}{}{}}%
  \begin{tabla}[ancho=completo, fuente=condensada, numerada=false]{Declaración de uso de IA}{usoia-\subdocActual}%
    {L{13mm} L{24mm} X L{15mm} L{17mm} L{44mm}}
  Sección & Herramienta & Finalidad del uso & Nivel en texto & Nivel en diagramas &
  Revisión humana (quién y qué verificó) \\ \midrule
  \filasUsoIA
  \end{tabla}}

% ----------------------------------------------------------------------------
%  Entregas conforme al Comunicado 10
% ----------------------------------------------------------------------------
\ExplSyntaxOn
\NewDocumentCommand \ListaFormulariosArchivo { m }
  {
    \tl_if_blank:eTF { \formulariosDeSubdocumento {#1} }
      { El~Formulario~T-21~no~asigna~formularios~a~este~subdocumento }
      {
        \seq_set_from_clist:Ne \l_tmpa_seq { \formulariosDeSubdocumento {#1} }
        \seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq
          { Formulario~##1,~en~el~archivo~ \dato{sigla} -Formulario- ##1 .pdf }
        \seq_use:Nnnn \l_tmpb_seq { ~y~ } { ,~ } { ~y~ }
      }
  }
\NewDocumentCommand \IncluirContenidoComunicado { m }
  {
    \tl_set:Ne \l_audit_carpeta_tl { \carpetaDeSubdocumento {#1} }
    \aperturaComunicado {#1}
    \audit_buscar:Vn \l_audit_carpeta_tl { contenido.tex }
    \tl_if_empty:NTF \l_audit_ruta_tl
      { \msg_error:nnV { ensamblado } { sin-contenido } \l_audit_carpeta_tl }
      { \file_input:V \l_audit_ruta_tl }
  }
\NewDocumentCommand \IncluirFormularioArchivo { m m }
  {
    % #1 carpeta del subdocumento, #2 formulario
    \audit_buscar:nn {#1} { formularios/#2.tex }
    \tl_if_empty:NTF \l_audit_ruta_tl
      { \EsqueletoFormulario {#2} }
      { \file_input:V \l_audit_ruta_tl }
  }
\ExplSyntaxOff

\RenewDocumentCommand\DocumentoSubdocumento{m}{%
  \FijarSubdocumento{#1}%
  \BuscarArchivoSubdoc{\carpetaDeSubdocumento{#1}}{meta.tex}%
  \InputIfFileExists{\rutaEncontrada}{}{}%
  \portadaSubdocumento
  \fichaDocumento{Subdocumento N.º #1. \tituloDeSubdocumento{#1}}%
    {\SiDato{descripcion}{\dato{descripcion}}{\marcador{descripción del subdocumento en meta.tex}}}%
    {\ListaFormulariosArchivo{#1}}%
  \audit@iniciarpartes
  \indiceDetallado
  \ObservacionesInstancia[#1]%
  \IncluirContenidoComunicado{#1}%
  \EmitirAnexosGraficos
  \cierreReferencias
  \cierreDeclaracionIA{#1}}

% Un formulario como archivo propio (Comunicado 10, sección 1, regla 1)
\newcommand\portadaFormulario[1]{%
  \audit@portadaimagen{portada}%
  \audit@portadatexto{\audit@rotuloportada}
    {Formulario #1}
    {\tituloFormulario{#1}}
    {\audit@datoportada{Entrega}{\dato{sobre}. \rotuloInstancia}%
     \audit@datoportada{Anexo de}{Subdocumento N.º \subdocActual. \tituloSubdocActual}%
     \audit@datoportada{Mandante}{\dato{cliente}}}}

\NewDocumentCommand\DocumentoFormulario{m m}{%
  % #1 número de subdocumento, #2 formulario
  \FijarSubdocumento{#1}%
  \BuscarArchivoSubdoc{\carpetaDeSubdocumento{#1}}{meta.tex}%
  \InputIfFileExists{\rutaEncontrada}{}{}%
  \portadaFormulario{#2}%
  \fichaDocumento{Formulario #2. \tituloFormulario{#2}}%
    {Formulario #2 de las bases (\form{#2}{\paginaFormulario{#2}}), anexo del
     Subdocumento N.º #1, \tituloSubdocActual, que lo cita y resume. Las
     fuentes citadas en este formulario están en las Referencias del
     Subdocumento N.º #1.}%
    {Este archivo}%
  \setcounter{chapter}{#1}%
  \audit@marcasubdoc{Subdocumento #1}%
  \markboth{\tituloSubdocActual}{}%
  \clearpage
  % Desde aquí las páginas pertenecen al subdocumento #1 (verificador, punto 20)
  \registrarFolio{formsd-#1}{Formulario #2. \tituloFormulario{#2}}%
  \IncluirFormularioArchivo{\carpetaDeSubdocumento{#1}}{#2}}

% Anexos de un subdocumento como archivo propio (Comunicado 10, sección 1, regla 1)
\newcommand\portadaAnexosSubdoc[1]{%
  \audit@portadaimagen{portada}%
  \audit@portadatexto{\audit@rotuloportada}
    {Anexos Técnicos}
    {Subdocumento N.º #1}
    {\audit@datoportada{Entrega}{\dato{sobre}. \rotuloInstancia}%
     \audit@datoportada{Documento Principal}{Subdocumento N.º #1. \tituloDeSubdocumento{#1}}%
     \audit@datoportada{Mandante}{\dato{cliente}}}}

\ExplSyntaxOn
\NewDocumentCommand \IncluirAnexosSubdoc { m }
  {
    \tl_set:Ne \l_audit_carpeta_tl { \carpetaDeSubdocumento {#1} }
    \audit_buscar:Vn \l_audit_carpeta_tl { anexos.tex }
    \tl_if_empty:NTF \l_audit_ruta_tl
      {
        \audit_buscar:Vn \l_audit_carpeta_tl { anexo-1a.tex }
        \tl_if_empty:NF \l_audit_ruta_tl
          { \file_input:V \l_audit_ruta_tl }
      }
      { \file_input:V \l_audit_ruta_tl }
  }
\ExplSyntaxOff

\NewDocumentCommand\DocumentoAnexos{m}{%
  % #1 número de subdocumento
  \FijarSubdocumento{#1}%
  \BuscarArchivoSubdoc{\carpetaDeSubdocumento{#1}}{meta.tex}%
  \InputIfFileExists{\rutaEncontrada}{}{}%
  \portadaAnexosSubdoc{#1}%
  \fichaDocumento{Anexos del Subdocumento N.º #1. \tituloDeSubdocumento{#1}}%
    {Documento de anexos técnicos independientes, matrices de soporte, inventarios exhaustivos y antecedentes probatorios que complementan analíticamente al Subdocumento N.º #1, \tituloSubdocActual, que los cita y resume.}%
    {Anexos técnicos independientes (Comunicado 10, sección 1)}%
  \audit@iniciarpartes
  \global\audit@indicelocaltrue
  \setcounter{chapter}{#1}%
  \audit@marcasubdoc{Subdocumento #1}%
  \markboth{\tituloSubdocActual}{}%
  \clearpage
  \registrarFolio{formsd-#1}{Anexos del Subdocumento #1. \tituloDeSubdocumento{#1}}%
  \IncluirAnexosSubdoc{#1}%
  \cierreDeclaracionIA{#1}}

\endinput
