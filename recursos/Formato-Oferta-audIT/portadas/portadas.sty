% ============================================================================
%  portadas.sty
%  Motivo gráfico, portada de la oferta, portada de subdocumento, ficha del
%  documento, bloque de firma completa y contraportada.
%
%  Motivo: la ruta. Una línea con los cinco terminales de Transportes Curimón
%  ubicados según su latitud real, de Antofagasta (23,65° S) a Puerto Montt
%  (41,47° S), sobre 3.000 km de ruta (Caso, capítulo 3, p. 8). San Bernardo,
%  casa matriz y único punto donde converge todo, es el nodo hexagonal del
%  logo. Va en portadas, aperturas de subdocumento y contraportada.
%
%  Las portadas se dibujan con TikZ anclado a la página, sin \newgeometry
%  (en el formato anterior \newgeometry dentro de la portada produjo un bucle
%  de páginas). Todo el texto es texto real, seleccionable.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{portadas}[2026/09/26 Portadas y motivo]

% ----------------------------------------------------------------------------
%  Motivo de la ruta
%  \motivoRuta{largo}{con rótulos: si|no}
% ----------------------------------------------------------------------------
\def\audit@terminales{%
  0/Antofagasta/arriba,0.558/San Bernardo/abajo,0.661/Talca/arriba,%
  0.776/Los Ángeles/abajo,1/Puerto Montt/arriba}

\tikzset{
  audit nodo/.style={circle, draw=audit-turquesa, fill=white, line width=0.9pt,
    inner sep=0pt, minimum size=5pt},
  audit matriz/.style={regular polygon, regular polygon sides=6,
    fill=audit-marino, draw=audit-marino, inner sep=0pt, minimum size=9pt},
}
\usetikzlibrary{shapes.geometric}

\newcommand\motivoRuta[2]{%
  \begin{tikzpicture}[baseline=0pt]
    \draw[audit-turquesa, line width=0.9pt] (0,0) -- (#1,0);
    \foreach \p/\n/\l in \audit@terminales {%
      \ifdim\p pt=0.558pt
        \node[audit matriz] at (\p*#1,0) {};
      \else
        \node[audit nodo] at (\p*#1,0) {};
      \fi
      \ifx\relax#2\relax\else
        \audit@anclarotulo{\p}{\l}%
        \node[anchor=\audit@ancla, font=\ttfamily\fontsize{9bp}{10bp}\selectfont,
          text=audit-secundario, inner sep=0pt] at (\p*#1,\audit@altorotulo) {\n};
      \fi
    }
  \end{tikzpicture}}
% Ancla del rótulo: los extremos se alinean hacia adentro, los intermedios al
% centro. Arriba o abajo de la línea según el terminal, para que no choquen.
\newcommand\audit@anclarotulo[2]{%
  \edef\audit@lado{#2}\def\audit@arriba{arriba}%
  \ifx\audit@lado\audit@arriba
    \def\audit@vert{south}\def\audit@altorotulo{6pt}%
  \else
    \def\audit@vert{north}\def\audit@altorotulo{-6pt}%
  \fi
  \ifdim#1pt=0pt \edef\audit@ancla{\audit@vert\space west}%
  \else\ifdim#1pt=1pt \edef\audit@ancla{\audit@vert\space east}%
  \else \edef\audit@ancla{\audit@vert}\fi\fi}

% Motivo en la cabeza de cada apertura de subdocumento, de carril a margen
\newcommand\motivoApertura{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=west, inner sep=0pt] at
      ($(current page.north west)+(\carrilInicio,-10mm)$)
      {\motivoRuta{\dimexpr\paperwidth-\carrilInicio-\bordeDerecho\relax}{}};
  \end{tikzpicture}}

% ----------------------------------------------------------------------------
%  Bloque de firma completa (FEP01, Artículo 40.2)
% ----------------------------------------------------------------------------
\newcommand\bloqueFirma{%
  \begin{minipage}[b]{76mm}
    \sffamily\fontsize{9.5bp}{12.5bp}\selectfont\color{audit-tinta}%
    \centering
    \begingroup\edef\audit@img{\dato{firmacompleta}}%
    \ifx\audit@img\@empty\rule{0pt}{12mm}%
    \else\IfFileExists{\audit@img}
      {\includegraphics[height=12mm,width=50mm,keepaspectratio]{\audit@img}}
      {\rule{0pt}{12mm}}\fi\endgroup\par
    \vspace{1pt}{\color{audit-marino}\rule{76mm}{0.6pt}}\par\vspace{3pt}%
    {\bfseries\color{audit-marino}\dato{representante}}\par
    \dato{representantecargo}, \dato{empresa}\par
    RUT \dato{representanterut}\par
    {\color{audit-secundario}Firma Electrónica Avanzada · Ley N.° 19.799}\par
  \end{minipage}}

% ----------------------------------------------------------------------------
%  Portada, en dos páginas
%  1. Imagen: la fotografía a sangre con el logo. Abajo, una franja blanca con
%     la media firma y el folio, que van en todas las páginas.
%  2. Carátula: identificación de la licitación, título, datos de la entrega,
%     motivo de la ruta y firma completa (FEP01, Artículo 40.2).
% ----------------------------------------------------------------------------
\newcommand\audit@portadaimagen[1]{%
  \clearpage
  \thispagestyle{empty}\pieSoloFolio
  \phantomsection
  \registrarFolio{#1}{Portada}%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (NO) at (current page.north west);
    % la foto se ancla abajo, sobre la franja del pie, y pierde parte del cielo
    \begin{scope}
      \clip (NO) rectangle ($(NO)+(\paperwidth,-\paperheight+24mm)$);
      \node[anchor=south west, inner sep=0pt] at ($(NO)+(0,-\paperheight+24mm)$)
        {\includegraphics[width=\paperwidth]{portadas/activos/camion.jpg}};
    \end{scope}
    \fill[audit-marino] ($(NO)+(0,-\paperheight+24mm)$) rectangle
      ($(NO)+(\paperwidth,-\paperheight+22.8mm)$);
    \node[anchor=north west, inner sep=0pt] at ($(NO)+(16mm,-16mm)$)
      {\includegraphics[height=19mm]{portadas/activos/logo-audit.png}};
  \end{tikzpicture}%
  \null\clearpage}

% #1 rótulo superior  #2 título  #3 subtítulo  #4 datos (pares rótulo y valor)
\newcommand\audit@portadatexto[4]{%
  \clearpage
  \thispagestyle{empty}\pieSoloFolio
  \begin{tikzpicture}[remember picture, overlay,
      every node/.style={inner sep=0pt, anchor=north west}]
    \coordinate (NO) at (current page.north west);
    \node at ($(NO)+(22mm,-22mm)$)
      {\includegraphics[height=12mm]{portadas/activos/logo-audit.png}};
    \node[text width=172mm] at ($(NO)+(22mm,-58mm)$) {%
      {\plexrotulo\fontsize{9bp}{12bp}\selectfont\color{audit-secundario}#1\par}%
      \vspace{5mm}%
      {\raggedright\sffamily\bfseries\fontsize{36bp}{42bp}\selectfont\color{audit-marino}#2\par}%
      \vspace{4mm}%
      {\raggedright\plexligera\fontsize{20bp}{25bp}\selectfont\color{audit-marino}#3\par}%
      \vspace{6mm}%
      {\color{audit-turquesa}\rule{30mm}{1.2pt}}\par
      \vspace{9mm}%
      #4};
    % motivo de la ruta con los cinco terminales
    \node[anchor=west] at ($(NO)+(22mm,-200mm)$)
      {\motivoRuta{\dimexpr\paperwidth-44mm\relax}{si}};
    % versión, fecha y lugar
    \node[text width=100mm, anchor=north west] at ($(NO)+(22mm,-222mm)$)
      {\sffamily\fontsize{9.5bp}{13bp}\selectfont\color{audit-tinta}%
       {\color{audit-secundario}Documento preparado para \dato{cliente}}\par
       Versión \dato{version}\enspace\textperiodcentered\enspace\fechaLarga
       \enspace\textperiodcentered\enspace\dato{lugar}};
    % firma completa (FEP01, Artículo 40.2)
    \node[anchor=north east] at ($(NO)+(\paperwidth-22mm,-214mm)$) {\bloqueFirma};
  \end{tikzpicture}%
  \null\clearpage}

% Par rótulo y valor de la carátula
\newcommand\audit@datoportada[2]{%
  {\plexrotulo\fontsize{9bp}{11bp}\selectfont\color{audit-secundario}\MakeUppercase{#1}\par}%
  \vspace{1.2mm}%
  {\raggedright\sffamily\fontsize{13bp}{17bp}\selectfont\color{audit-marino}#2\par}%
  \vspace{5mm}}

\newcommand\audit@rotuloportada{%
  EMPRESA N.º \dato{empresanumero}\enspace\textperiodcentered\enspace
  LICITACIÓN \dato{licitacioncorta}\enspace\textperiodcentered\enspace
  \MakeUppercase{\dato{caso}}}

\newcommand\portadaOferta{%
  \audit@portadaimagen{portada}%
  \audit@portadatexto{\audit@rotuloportada}
    {\dato{titulosobre}}
    {\rotuloInstancia}
    {\audit@datoportada{Proyecto}{\dato{proyecto}}%
     \audit@datoportada{Mandante}{\dato{cliente}}%
     \audit@datoportada{Licitación}{\dato{licitacion}, \dato{caso}}}}

\newcommand\portadaSubdocumento{%
  \audit@portadaimagen{portada}%
  \audit@portadatexto{\audit@rotuloportada}
    {Subdocumento N.º \subdocActual}
    {\tituloSubdocActual}
    {\audit@datoportada{Entrega}{\dato{sobre}. \rotuloInstancia}%
     \audit@datoportada{Proyecto}{\dato{proyecto}}%
     \audit@datoportada{Mandante}{\dato{cliente}}}}

% ----------------------------------------------------------------------------
%  Ficha del documento
% ----------------------------------------------------------------------------
\newcommand\audit@filaficha[2]{%
  \noindent\parbox[t]{45mm}{\RaggedRight\sffamily\fontsize{9.5bp}{13bp}\selectfont
    \color{audit-secundario}#1}%
  \parbox[t]{\dimexpr\linewidth-45mm\relax}{\RaggedRight\sffamily
    \fontsize{10bp}{13bp}\selectfont\color{audit-tinta}#2}\par
  \vspace{2pt}\filetefino\vspace{3pt}}

% La convención de citas va en la ficha. En el documento único, donde la
% ficha es más larga, pasa al pie del índice general.
\newif\ifaudit@fichacitas \audit@fichacitastrue

% \fichaDocumento{documento}{contenido}{formularios}
\newcommand\fichaDocumento[3]{%
  \clearpage
  \begin{paginaAncha}%
  \tituloPagina{\dato{empresa}\enspace\textperiodcentered\enspace Empresa N.º \dato{empresanumero}}%
    {Ficha del documento}{ficha}%
  \audit@filaficha{Proponente}{\dato{empresa}, Empresa N.º \dato{empresanumero}.
    RUT \dato{empresarut}. Casa matriz en \dato{domicilio}}%
  \audit@filaficha{Representante legal}{\dato{representante}, RUT \dato{representanterut}}%
  \audit@filaficha{Mandante}{\dato{cliente}}%
  \audit@filaficha{Licitación}{\dato{licitacion}, \dato{caso}}%
  \audit@filaficha{Proyecto}{\dato{proyecto}}%
  \audit@filaficha{Instancia}{\dato{sobre}. \rotuloInstancia}%
  \audit@filaficha{Documento}{#1}%
  \audit@filaficha{Contenido}{#2}%
  \audit@filaficha{Formularios}{#3}%
  \audit@filaficha{Archivo}{{\ttfamily\fontsize{10bp}{13bp}\selectfont\ArchivoActual.pdf}}%
  \audit@filaficha{Folios}{Del \FolioInicialExterno\ al \pageref{LastPage}, correlativos,
    en el extremo inferior derecho de cada página}%
  \audit@filaficha{Versión y fecha}{Versión \dato{version}, \fechaLarga, \dato{lugar}}%
  \ifaudit@fichacitas\audit@filaficha{Citas}{\convencionCitas}\fi
  \vspace{14pt}%
  \noindent\hfill\bloqueFirma\par
  \end{paginaAncha}%
  \clearpage}

% ----------------------------------------------------------------------------
%  Contraportada. Único lugar, junto con la portada, donde van las frases de
%  marca del manual.
% ----------------------------------------------------------------------------
\newcommand\contraportada{%
  \clearpage
  \thispagestyle{empty}\pieSoloFolio
  \begin{tikzpicture}[remember picture, overlay,
      every node/.style={inner sep=0pt, anchor=north west}]
    \coordinate (NO) at (current page.north west);
    \fill[audit-marino] (NO) rectangle ($(NO)+(\paperwidth,-238mm)$);
    \node at ($(NO)+(18mm,-30mm)$)
      {\includegraphics[height=17mm]{portadas/activos/logo-audit-negativo.png}};
    \node at ($(NO)+(18mm,-52mm)$)
      {\plexrotulo\fontsize{10bp}{12bp}\selectfont\color{white}INGENIERÍA PARA OPERACIONES CRÍTICAS};
    \node[text width=150mm] at ($(NO)+(18mm,-96mm)$)
      {\sffamily\bfseries\fontsize{26bp}{32bp}\selectfont\color{white}%
       Conectamos datos.\\Sostenemos operaciones.\\Generamos confianza.};
    \node[text width=175mm] at ($(NO)+(18mm,-150mm)$)
      {\sffamily\fontsize{12bp}{15bp}\selectfont\color{audit-turquesa}%
       Conecta\enspace\textperiodcentered\enspace Audita\enspace
       \textperiodcentered\enspace Optimiza\enspace\textperiodcentered\enspace Garantiza};
    \node[anchor=west] at ($(NO)+(18mm,-172mm)$)
      {\begingroup\color{white}\motivoRuta{\dimexpr\paperwidth-33mm\relax}{}\endgroup};
    \node[text width=175mm] at ($(NO)+(18mm,-205mm)$)
      {\plexrotulo\fontsize{10bp}{13bp}\selectfont\color{white}%
       TECNOLOGÍA QUE MANTIENE EL MUNDO EN MOVIMIENTO};
    \node[text width=175mm] at ($(NO)+(18mm,-218mm)$)
      {\sffamily\fontsize{9.5bp}{12bp}\selectfont\color{audit-gris-claro}%
       \dato{empresa}\enspace\textperiodcentered\enspace\dato{domicilio}};
  \end{tikzpicture}%
  \null\clearpage}

