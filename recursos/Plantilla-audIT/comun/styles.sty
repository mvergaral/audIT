\tikzstyle{arrow} = [very thick,->,>=stealth]
% Tabla del informe: cuerpo a 10 pt, sobre el minimo de 9 pt del Articulo 40.3
\usepackage{longtable}
\usepackage{booktabs}
\newenvironment{tablaAudit}[3]
  {\begin{center}\small\begin{longtable}{#3}
   \caption{\leyendaFont{#1}}\label{tab:#2}\\\toprule}
  {\bottomrule\end{longtable}\end{center}}

% Figura en pagina vertical. Se ajusta al ancho y nunca excede el alto util,
% de modo que no se corta al final de la pagina.
\usepackage{float}
\newcommand{\figuraAncha}[3]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=\linewidth,height=0.80\textheight,keepaspectratio]{#1}
    \caption{\leyendaFont{#2}}
    \label{fig:#3}
  \end{figure}}

% Entornos de alerta
\newenvironment{alertInfo}
  {\vspace{6pt}\begin{quote}\small\color{audITnavy}\rule{\linewidth}{0.8pt}\par\noindent\textbf{IMPORTANTE:}\enspace\ignorespaces}
  {\par\noindent\rule{\linewidth}{0.8pt}\end{quote}\vspace{6pt}}

\newenvironment{alertWarning}
  {\vspace{6pt}\begin{quote}\small\color{audITnavy}\rule{\linewidth}{0.8pt}\par\noindent\textbf{ADVERTENCIA / LÍMITE:}\enspace\ignorespaces}
  {\par\noindent\rule{\linewidth}{0.8pt}\end{quote}\vspace{6pt}}
